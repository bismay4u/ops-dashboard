# Copy to .env and edit before running in production
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_COOKIE_NAME=ops_dash_session
# How many hops of X-Forwarded-For to trust (set to number of proxies in front,
# e.g. 1 if Nginx Proxy Manager sits directly in front of this app)
TRUST_PROXY_HOPS=1
# Seconds between live-status checks
STATUS_CHECK_INTERVAL_SECONDS=60
# HTTP timeout per status check, ms
STATUS_CHECK_TIMEOUT_MS=5000
# Feedback items still open/pending after this many days auto-close
FEEDBACK_AUTO_CLOSE_DAYS=45
# Default admin bootstrap (only used the first time the DB is created)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-immediately
# Force Cache-Control: no-cache on served .css/.js so browsers always revalidate
# instead of serving stale assets after a deploy. Off by default.
DISABLE_STATIC_CACHE=false
# HTTP timeout per RunBook run, ms
RUNBOOK_TIMEOUT_MS=15000
# SMTP settings for RunBook "notify" emails. Leave SMTP_HOST unset to disable email
# sending entirely — runs still work and log normally, notify_email is just skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
